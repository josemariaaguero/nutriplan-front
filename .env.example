# API NutriPlan (FastAPI)
VITE_API_URL=http://127.0.0.1:8000

# Supabase Auth (mismo proyecto que usas como Postgres)
# Dashboard → Settings → API Keys → Publishable and secret API keys
# (no uses la anon key legacy)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Auth setup en el dashboard (gratis):
# 1. Authentication → Providers → Email: activado
# 2. Desactiva “Confirm email” — el SMTP gratis (~2 mails/h) se agota con
#    confirmaciones de registro; sin confirmación el signUp deja sesión al momento.
#    Cuando tengas SMTP propio (Resend, etc.) puedes volver a activarla.
# 3. Authentication → URL Configuration:
#    Site URL: URL de producción (ej. https://tudominio.com) — NO dejar localhost en prod
#    Redirect URLs (ambos si desarrollas en local):
#      https://tudominio.com/**
#      http://localhost:5173/**
