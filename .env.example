# API NutriPlan (FastAPI)
VITE_API_URL=http://127.0.0.1:8000

# Supabase Auth (mismo proyecto que usas como Postgres)
# Dashboard → Settings → API Keys → Publishable and secret API keys
# (no uses la anon key legacy)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Auth setup en el dashboard (gratis):
# 1. Authentication → Providers → Email: activado
# 2. Para local: desactiva "Confirm email"
# 3. Authentication → URL Configuration:
#    Site URL: http://localhost:5173
#    Redirect URLs: http://localhost:5173/**
